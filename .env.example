# IA generativa (Issue #6). Copie para .env; nunca commite o .env.
# bedrock = síntese pelo Amazon Bedrock; nenhum = só resposta extrativa (padrão)
LLM_PROVIDER=nenhum
# Perfil local da AWS CLI (credenciais ficam fora do repositório)
AWS_PROFILE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=us.cohere.embed-v4:0
