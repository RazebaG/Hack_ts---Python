# Copie para .env (que não vai para o repositório) e preencha localmente.
# Nunca coloque chaves, segredos, tokens ou IDs de conta neste arquivo nem em arquivos commitados.

# Configuração do Provedor de IA (Amazon Bedrock - HACKA/TS 2026)
# O perfil local hackats na máquina do evento já possui as permissões necessárias.
LLM_PROVIDER=nenhum
AWS_PROFILE=hackats
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=us.cohere.embed-v4:0

# API do acervo consumida pelos canais (padrão: http://localhost:8000)
API_URL=http://localhost:8000
# Painel web (link "Abrir no painel" nos cartões)
PAINEL_URL=http://localhost:5173

# Slack (Bolt, Socket Mode) — app criado no workspace de teste
# Bot User OAuth Token (começa com xoxb-)
SLACK_BOT_TOKEN=
# App-Level Token com escopo connections:write (começa com xapp-)
SLACK_APP_TOKEN=
