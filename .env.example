# Copie para .env (que não vai para o repositório) e preencha localmente.
# Nunca coloque chaves, segredos, tokens ou IDs de conta neste arquivo nem em arquivos commitados.

# Configuração de Segurança Mínima da API
# API_KEY: Protege endpoints exigindo cabeçalho X-API-Key (vazio = autenticação desligada)
API_KEY=
# RATE_LIMIT_POR_MINUTO: Limite de requisições por minuto por IP (vazio ou 0 = desligado)
RATE_LIMIT_POR_MINUTO=
# CORS_ORIGINS: Origens permitidas separadas por vírgula (vazio = padrão localhost/127.0.0.1)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Configuração do Provedor de IA (Amazon Bedrock - HACKA/TS 2026)
# O perfil local hackats na máquina do evento já possui as permissões necessárias.
LLM_PROVIDER=nenhum
AWS_PROFILE=hackats
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=us.cohere.embed-v4:0

# API do acervo consumida pelos canais (padrão: http://localhost:8000)
API_URL=http://localhost:8000
# Painel web (link "Abrir no painel" nos cartões)
PAINEL_URL=http://localhost:5173

# Slack (Bolt, Socket Mode) — app criado no workspace de teste
# Bot User OAuth Token (começa com xoxb-)
SLACK_BOT_TOKEN=
# App-Level Token com escopo connections:write (começa com xapp-)
SLACK_APP_TOKEN=

# Agente Teams (app/canais/teams.py)
# Porta do agente (Agents Playground usa http://localhost:3978/api/messages)
TEAMS_PORTA=3978
# Perfil enviado a /api/perguntar (empregado, gestor, diretoria, financeiro, juridico, rh). Vazio = geral
TEAMS_PERFIL=
# Credenciais do Azure Bot / Entra ID. Ficam VAZIAS no Playground (modo anônimo).
# Publicação no tenant é o plano de 6 meses.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
