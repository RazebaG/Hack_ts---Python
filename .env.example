# Copie para .env (que não vai para o repositório) e preencha localmente.
# Nunca coloque valores reais neste arquivo.

# API do acervo consumida pelos canais (padrão: http://localhost:8000)
API_URL=http://localhost:8000
# Painel web (link "Abrir no painel" nos cartões e nas citações)
PAINEL_URL=http://localhost:5173

# Slack (Bolt, Socket Mode) — app criado no workspace de teste
# Bot User OAuth Token (começa com xoxb-)
SLACK_BOT_TOKEN=
# App-Level Token com escopo connections:write (começa com xapp-)
SLACK_APP_TOKEN=

# Agente Teams (app/canais/teams.py)
# Porta do agente (Agents Playground usa http://localhost:3978/api/messages)
TEAMS_PORTA=3978
# Perfil enviado a /api/perguntar (empregado, gestor, diretoria, financeiro, juridico, rh). Vazio = geral
TEAMS_PERFIL=
# Credenciais do Azure Bot / Entra ID. Ficam VAZIAS no Playground (modo anônimo).
# Publicação no tenant é o plano de 6 meses.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
